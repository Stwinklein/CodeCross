# Copy this file to .env for local development.
# Do not commit the real .env file. GitHub Actions should receive these values
# through repository Secrets and Variables instead.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-opus-4-8

# SWE-PRBench 等 human-alignment 评测默认让两个独立角色都使用 Anthropic，
# 以测 Reviewer 能力上限；产品 defect_detection 仍使用 DeepSeek + Anthropic。
# 如需做跨模型成本/消融对照，可改为 deepseek。
CODECROSS_HUMAN_ALIGNMENT_PRIMARY_PROVIDER=anthropic

# Optional: LangSmith 数据集与实验上传。未配置时本地评测仍可完整运行。
LANGSMITH_API_KEY=
# Key 能访问多个 workspace 时必填；在 LangSmith Settings > General 中查看。
LANGSMITH_WORKSPACE_ID=
# 本项目当前使用 LangSmith 欧洲区；美区账号请删除此行或改为美国 endpoint。
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=codecross-evaluation
LANGSMITH_TRACING=false

# Optional: 使用独立 judge 模型可减少“被测模型自己给自己打分”的偏差。
CODECROSS_EVAL_JUDGE_PROVIDER=anthropic
CODECROSS_EVAL_JUDGE_MODEL=claude-opus-4-8
CODECROSS_EVAL_JUDGE_API_KEY_ENV=ANTHROPIC_API_KEY
CODECROSS_EVAL_JUDGE_BASE_URL_ENV=ANTHROPIC_BASE_URL

# Optional: set to true only when testing CI wiring without real model calls.
CODECROSS_MOCK_LLM=false
